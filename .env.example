# ==============================
# تنظیمات دیتابیس Postgres (روی سرور VPS خودتان)
# ==============================
# فرمت کلی: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# اگر پروژه روی همان سروری اجرا می‌شود که Postgres رویش نصب است از localhost استفاده کنید.
# اگر اتصال باید رمزنگاری شده باشد (SSL) در انتها ?sslmode=require اضافه کنید.
DATABASE_URL=postgresql://amlak_user:CHANGE_ME_STRONG_PASSWORD@YOUR_VPS_IP_OR_localhost:5432/amlak

# ==============================
# رمز عبور ورود به پنل ادمین
# ==============================
# حتما این را به یک رمز قوی تغییر دهید. دیگر در کد نوشته نشده و فقط سمت سرور چک می‌شود.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# رشته تصادفی برای امضای کوکی نشست ادمین (هر مقدار طولانی و تصادفی)
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_LONG_STRING
